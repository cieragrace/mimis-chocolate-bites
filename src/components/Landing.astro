---
/**
 * LANDING — one screen on any device, no scroll.
 * Moody three-band styling (brown header / beige logo band / brown hero) with
 * two buttons: "Place an inquiry" → /contact, "Follow" → Instagram.
 *
 * min-h-[100svh] + a flex-1 <main> fills exactly one viewport when the content
 * fits (so no scroll on portrait/tablet/desktop, and no iOS address-bar jump).
 * On very short LANDSCAPE phones we shrink the logo/headline and drop the
 * tagline (the `short:` variant, @media(max-height:600px)) so it still fits.
 */
import Truffle from './Truffle.astro';
import CakePop from './CakePop.astro';
import RainField from './RainField.astro';

const IG_URL = 'https://instagram.com/mimischocolatebites';
const offerings = ['Chocolate bites', 'Cake pops', 'Gift boxes', 'Custom orders'];

const focusRing =
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#241009]';
---

<div class="relative flex min-h-[100svh] flex-col justify-center bg-[#241009] text-cream">
  <RainField />

  {/* ── HEADER: pill + beige logo band ─────────────────────────── */}
  <header class="relative z-10 shrink-0">
    <div class="px-6 pb-3 pt-2 text-center short:pb-1.5 short:pt-2">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-gold/40 px-5 py-2 text-[13px] font-semibold uppercase tracking-[0.25em] text-gold"
      >
        <svg class="h-4 w-4 shrink-0 text-blush" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        /></svg>
        Made with love
      </span>
    </div>

    <div class="flex items-center justify-center bg-[#e9ddc7] px-6 py-3 short:py-1.5">
      <img
        src="/img/logo.png"
        alt="Mimi's Chocolate Bites"
        width="360"
        class="w-48 sm:w-56 lg:w-72 short:w-20"
      />
    </div>
  </header>

  {/* ── MAIN hero — fills the rest, centered ───────────────────── */}
  <main class="relative z-10 flex flex-col items-center px-6 pt-10 pb-6 text-center short:py-3">
    <h1 class="font-serif text-3xl leading-tight text-cream sm:text-4xl lg:text-5xl short:text-xl">
      Handcrafted chocolate,<br />made with love.
    </h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-cream/70 lg:text-xl short:hidden">
      Small-batch chocolate bites, cake pops &amp; sweet little indulgences — made just for you.
    </p>

    <div class="mt-11 flex flex-wrap items-center justify-center gap-3 short:mt-4">
      <a
        href="/contact"
        class={`inline-flex items-center gap-2 rounded-full bg-gold px-8 py-3.5 font-bold text-cocoa shadow-lg transition hover:-translate-y-0.5 hover:brightness-105 focus-visible:ring-cream ${focusRing}`}
      >
        <CakePop class="-ml-1 h-6 w-auto shrink-0 drop-shadow-sm" />
        Place an inquiry
      </a>
      <a
        href={IG_URL}
        target="_blank"
        rel="noopener"
        aria-label="Follow Mimi's Chocolate Bites on Instagram (opens in a new tab)"
        class={`inline-flex items-center gap-2 rounded-full border-2 border-cream/25 px-6 py-3.5 font-semibold text-cream transition hover:border-blush hover:text-blush focus-visible:ring-blush ${focusRing}`}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5.5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
        </svg>
        Follow
      </a>
    </div>

    {/* offerings — hidden on short (landscape) screens to stay one-screen */}
    <ul
      class="mt-11 flex list-none flex-wrap items-center justify-center gap-x-2.5 gap-y-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-gold/80 short:hidden"
    >
      {offerings.map((o, i) => (
        <li class="flex items-center gap-x-2.5">
          {i > 0 && <Truffle class="h-2.5 w-2.5 shrink-0 opacity-80" />}
          <span>{o}</span>
        </li>
      ))}
    </ul>
  </main>
</div>

<style>
  /* `short:` = a very short viewport, i.e. a phone in landscape */
  @media (max-height: 600px) {
    .short\:pt-2 { padding-top: 0.5rem; }
    .short\:pb-1\.5 { padding-bottom: 0.375rem; }
    .short\:py-1\.5 { padding-top: 0.375rem; padding-bottom: 0.375rem; }
    .short\:py-3 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
    .short\:mt-4 { margin-top: 1rem; }
    .short\:w-20 { width: 5rem; }
    .short\:text-xl { font-size: 1.25rem; line-height: 1.75rem; }
    .short\:hidden { display: none; }
  }
</style>
