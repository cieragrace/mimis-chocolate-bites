---
/**
 * Cake-pop icon for buttons (based on Mimi's reference image): a pink ball with
 * sprinkles, dipped in chocolate at the bottom, on a little stick.
 *
 * Solid shapes only — no <defs>/clipPath/gradient — because both design
 * versions render into the DOM at once (one is display:none) and shared SVG
 * ids referenced from a hidden subtree paint as nothing.
 */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 24 24" class={cls} aria-hidden="true">
  {/* stick */}
  <rect x="11.1" y="15.5" width="1.8" height="7.5" rx="0.9" fill="#d8a56b" />
  {/* pink ball */}
  <circle cx="12" cy="9" r="7" fill="#efa0b2" />
  {/* chocolate dip (bottom cap with a drippy top edge) */}
  <path
    d="M5.6 10.8 C 7.1 12.9, 8.9 11.9, 10.4 12.5 C 12 13.1, 13.4 11.7, 15 12.1 C 16.3 12.4, 17.4 11.5, 18.4 10.8 A 7 7 0 0 1 5.6 10.8 Z"
    fill="#5a3826"
  />
  {/* sprinkles on the pink */}
  <line x1="8.6" y1="6.4" x2="9.8" y2="5.6" stroke="#ffffff" stroke-width="1.1" stroke-linecap="round" />
  <line x1="13.4" y1="5.2" x2="14.6" y2="6.2" stroke="#7a5138" stroke-width="1.1" stroke-linecap="round" />
  <line x1="11" y1="8" x2="12.3" y2="7.6" stroke="#ffffff" stroke-width="1.1" stroke-linecap="round" />
  <line x1="15" y1="8.4" x2="15.9" y2="9.4" stroke="#ffffff" stroke-width="1.1" stroke-linecap="round" />
</svg>
