---
/**
 * A little hand-drawn cake pop (ball on a stick with sprinkles). Colors are
 * props so we can scatter a bunch of different flavors across the playful page.
 */
interface Props {
  ball?: string;
  drip?: string;
  class?: string;
}
const { ball = '#e79bab', drip = '#fff', class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 60 100" class={cls} aria-hidden="true">
  <rect x="28.5" y="45" width="3" height="52" rx="1.5" fill="#d8c3a5" />
  <circle cx="30" cy="30" r="26" fill={ball} />
  <path d="M6 26 Q30 44 54 26 Q54 40 42 48 Q30 55 18 48 Q6 40 6 26 Z" fill={drip} opacity="0.9" />
  <circle cx="22" cy="20" r="1.7" fill={drip} />
  <circle cx="36" cy="16" r="1.7" fill={drip} />
  <circle cx="42" cy="28" r="1.7" fill={drip} />
  <circle cx="26" cy="32" r="1.7" fill={drip} />
</svg>
