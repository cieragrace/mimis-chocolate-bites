---
/**
 * Shared inquiry form used by both design versions.
 *
 * Wired for Web3Forms (same as Ciera's other client sites): the form POSTs to
 * api.web3forms.com with a hidden access_key. Drop Mimi's real key into
 * WEB3FORMS_KEY below (or a PUBLIC_WEB3FORMS_KEY env var) and it starts
 * emailing inquiries straight to her inbox — no backend needed.
 *
 * Until a real key is set, the form is styled + validates but submission is
 * disabled (button shows "Demo — form goes live once connected").
 */
interface Props {
  /** Visual skin: 'simple', 'playful', 'moody' (gold), 'cool' (teal) */
  theme?: 'simple' | 'playful' | 'moody' | 'cool';
}
const { theme = 'simple' } = Astro.props;

import CakePop from './CakePop.astro';

const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
const isLive = WEB3FORMS_KEY.length > 10;

// Optional Google Apps Script Web App URL. When set, each inquiry is also
// appended as a row to a Google Sheet (for later reporting). Purely additive —
// the email via Web3Forms is unaffected if this is empty or fails.
const SHEET_LOG_URL = import.meta.env.PUBLIC_SHEET_LOG_URL || '';

const playful = theme === 'playful';
const moody = theme === 'moody';
const cool = theme === 'cool';

const fieldBase =
  'w-full rounded-2xl border bg-white/90 px-4 py-2.5 text-cocoa placeholder-cocoa-soft outline-none transition focus:ring-2';
const fieldSkin = playful
  ? 'border-blush/50 focus:border-blush focus:ring-blush/40'
  : moody
    ? 'border-gold/40 focus:border-gold focus:ring-gold/30'
    : cool
      ? 'border-[#bcd6cc] focus:border-[#2f6f66] focus:ring-[#2f6f66]/25'
      : 'border-cream-deep focus:border-choc focus:ring-choc/25';
const labelSkin = 'mb-1 block text-sm font-semibold text-cocoa';
const btnSkin = playful
  ? 'bg-blush text-white hover:brightness-105 hover:-translate-y-0.5'
  : moody
    ? 'bg-gold text-cocoa hover:brightness-105 hover:-translate-y-0.5'
    : cool
      ? 'bg-[#2f6f66] text-white hover:brightness-110 hover:-translate-y-0.5'
      : 'bg-cocoa text-cream hover:bg-choc';
---

<form
  class="mx-auto w-full max-w-lg text-left"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-inquiry-form
  data-sheet-log={SHEET_LOG_URL}
>
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="New inquiry — Mimi's Chocolate Bites" />
  <input type="hidden" name="from_name" value="Mimi's Chocolate Bites website" />
  {/* honeypot */}
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-2.5">
    <p class="-mb-1 text-xs text-cocoa-soft"><span class="text-blush">*</span> Required</p>
    <div>
      <label class={labelSkin} for="name">Your name <span class="text-blush" aria-hidden="true">*</span></label>
      <input class={`${fieldBase} ${fieldSkin}`} id="name" name="name" type="text" autocomplete="name" required placeholder="Jane Doe" />
    </div>
    <div class="grid gap-2.5 sm:grid-cols-2">
      <div>
        <label class={labelSkin} for="email">Email <span class="text-blush" aria-hidden="true">*</span></label>
        <input class={`${fieldBase} ${fieldSkin}`} id="email" name="email" type="email" autocomplete="email" required placeholder="you@email.com" />
      </div>
      <div>
        <label class={labelSkin} for="phone">Phone</label>
        <input class={`${fieldBase} ${fieldSkin}`} id="phone" name="phone" type="tel" autocomplete="tel" placeholder="(555) 123-4567" />
      </div>
    </div>
    <div class="grid gap-2.5 sm:grid-cols-2">
      <div>
        <label class={labelSkin} for="occasion">Occasion</label>
        <input class={`${fieldBase} ${fieldSkin}`} id="occasion" name="Occasion" type="text" placeholder="Birthday, baby shower…" />
      </div>
      <div>
        <label class={labelSkin} for="date-needed">Date needed</label>
        <input class={`${fieldBase} ${fieldSkin}`} id="date-needed" name="Date needed" type="date" />
      </div>
    </div>
    {/* Treats — each repeatable group is ONE treat: type + quantity + premade
        flavor (fall menu — swap options as it rotates) + build-your-own fields.
        "+ Add another treat" clones the whole group; JS renumbers names to
        "Treat 1"/"Treat 1 quantity"/"Treat 1 premade flavor"/… for the email. */}
    <div class="grid gap-2.5" data-treat-rows>
      <div class="grid gap-2.5" data-treat-row>
        <div class="grid gap-2.5 sm:grid-cols-2">
          <div>
            <label class={labelSkin} for="treat-1">Treat type</label>
            <select class={`${fieldBase} ${fieldSkin}`} id="treat-1" name="Treat 1">
              <option value="">Choose a treat</option>
              <option>Cake pops</option>
              <option>Cakesicles</option>
              <option>Chocolate covered Oreos</option>
              <option>Chocolate covered strawberries</option>
              <option>Chocolate covered pretzels</option>
              <option>Rice Krispies</option>
              <option>Marshmallows</option>
              <option>Something else</option>
            </select>
          </div>
          <div>
            <label class={labelSkin} for="treat-1-qty">Quantity</label>
            <div class="flex gap-2">
              <input class={`${fieldBase} ${fieldSkin}`} id="treat-1-qty" name="Treat 1 quantity" type="text" placeholder="e.g. 2 dozen" />
              <button
                type="button"
                data-remove-row
                aria-label="Remove this treat"
                class="hidden h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-cocoa/20 text-lg font-bold text-cocoa-soft transition hover:border-blush hover:text-blush focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush"
              >&times;</button>
            </div>
          </div>
        </div>
        <div>
          <label class={labelSkin} for="treat-1-flavor">Premade flavor</label>
          <select class={`${fieldBase} ${fieldSkin}`} id="treat-1-flavor" name="Treat 1 premade flavor">
            <option value="">Choose a premade flavor</option>
            <option>Pumpkin Spice</option>
            <option>Biscoff Cookie Butter</option>
            <option>Maple Pecan</option>
            <option>Snickerdoodle</option>
            <option>S'mores</option>
            <option>Cookies &amp; Cream</option>
            <option>Cookie Monster</option>
            <option>Salted Caramel Chocolate</option>
            <option>Chocolate Peanut Butter</option>
            <option>Orange Spice</option>
            <option>Build my own</option>
          </select>
        </div>
        <p class="my-0.5 text-center text-xs font-bold uppercase tracking-[0.15em] text-cocoa-soft" aria-hidden="true">
          — or build your own —
        </p>
        <div class="grid gap-2.5 sm:grid-cols-2">
          <div>
            <label class={labelSkin} for="treat-1-choc">Chocolate preference</label>
            <input class={`${fieldBase} ${fieldSkin}`} id="treat-1-choc" name="Treat 1 chocolate preference" type="text" placeholder="Milk, dark, white…" />
          </div>
          <div>
            <label class={labelSkin} for="treat-1-theme">Toppings / colors / theme</label>
            <input class={`${fieldBase} ${fieldSkin}`} id="treat-1-theme" name="Treat 1 toppings / colors / theme" type="text" placeholder="Sprinkles, pink &amp; gold…" />
          </div>
        </div>
      </div>
    </div>
    <button
      type="button"
      data-add-treat
      class="hidden -mt-0.5 justify-self-start text-sm font-bold text-cocoa underline-offset-2 transition hover:text-blush hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush"
    >+ Add another treat</button>
    <div class="grid gap-2.5 sm:grid-cols-2">
      <div>
        <label class={labelSkin} for="packaging">Packaging preference</label>
        <input class={`${fieldBase} ${fieldSkin}`} id="packaging" name="Packaging preference" type="text" placeholder="Individually wrapped, gift box…" />
      </div>
      <div>
        <label class={labelSkin} for="pickup-delivery">Pickup / delivery</label>
        <select class={`${fieldBase} ${fieldSkin}`} id="pickup-delivery" name="Pickup or delivery">
          <option value="">No preference yet</option>
          <option>Pickup</option>
          <option>Delivery</option>
        </select>
      </div>
    </div>
    <div>
      <label class={labelSkin} for="budget">Budget</label>
      <input class={`${fieldBase} ${fieldSkin}`} id="budget" name="Budget" type="text" placeholder="$" />
    </div>
    <div>
      <label class={labelSkin} for="notes">Special notes</label>
      <textarea
        rows="2"
        class={`${fieldBase} ${fieldSkin} min-h-16 max-h-[40vh] resize-y`}
        id="notes"
        name="Special notes"
        placeholder="Anything else Mimi should know…"></textarea>
    </div>

    <button
      type="submit"
      class={`inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 text-base font-bold shadow-md transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cocoa/60 focus-visible:ring-offset-2 focus-visible:ring-offset-cream disabled:cursor-not-allowed ${btnSkin}`}
      data-submit
      disabled={!isLive}
    >
      <CakePop class="-ml-0.5 h-6 w-auto shrink-0 drop-shadow-sm" />
      <span data-btn-label>{isLive ? 'Submit' : 'Testing 123...'}</span>
    </button>

    <p class="text-center text-sm text-cocoa-soft" data-form-status aria-live="polite">
      {isLive ? 'Mimi usually replies within a day.' : ''}
    </p>

    {/* Colorado Cottage Foods Act disclosure — Mimi's exact wording, keep verbatim */}
    <p class="mt-1 text-xs italic leading-relaxed text-cocoa-soft">
      *These products are produced in a home kitchen that is not subject to state licensure
      or inspection and that may also process common food allergies such as tree nuts,
      peanuts, eggs, soy, wheat, milk, fish and crustacean shellfish.
    </p>
  </div>
</form>

{/* Success pop-up — shown after a successful submit */}
<div
  data-success-modal
  class="fixed inset-0 z-50 hidden items-center justify-center bg-cocoa/70 px-6 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="success-title"
>
  <div class="w-full max-w-sm rounded-3xl bg-cream p-8 text-center shadow-2xl">
    <CakePop class="mx-auto mb-3 h-14 w-auto drop-shadow-sm" />
    <h2 id="success-title" class="font-serif text-2xl font-bold text-cocoa">Thank you!</h2>
    <p class="mt-2 text-cocoa-soft">Mimi will be in touch soon.</p>
    <div class="mt-6 flex flex-col gap-2.5">
      <button
        type="button"
        data-modal-again
        class={`inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 font-bold shadow-md transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cocoa/60 focus-visible:ring-offset-2 focus-visible:ring-offset-cream ${btnSkin}`}
      >
        Place another inquiry
      </button>
      <a
        href="/"
        class="rounded-full border-2 border-cocoa/20 px-6 py-3 font-semibold text-cocoa transition hover:border-cocoa/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cocoa/40 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
      >
        Back to home
      </a>
    </div>
  </div>
</div>

<script>
  // Repeatable treat rows: "+ Add another treat" clones the first row so one
  // order can mix kinds. JS-only feature — the button stays hidden without it.
  document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach((form) => {
    const container = form.querySelector<HTMLElement>('[data-treat-rows]');
    const addBtn = form.querySelector<HTMLButtonElement>('[data-add-treat]');
    if (!container || !addBtn) return;
    const MAX_ROWS = 6;
    const rows = () => Array.from(container.querySelectorAll<HTMLElement>('[data-treat-row]'));

    const renumber = () => {
      rows().forEach((row, i) => {
        const n = i + 1;
        // DOM order within a group: selects [type, flavor], inputs [qty, choc, theme],
        // labels [type, qty, flavor, choc, theme]
        const [typeSelect, flavorSelect] = Array.from(row.querySelectorAll('select'));
        const [qty, choc, theme] = Array.from(row.querySelectorAll('input'));
        const labels = Array.from(row.querySelectorAll('label'));
        const wire = (field: HTMLElement | undefined, label: HTMLLabelElement | undefined, id: string, name: string) => {
          if (field) { field.id = id; (field as HTMLInputElement).name = name; }
          if (label) label.htmlFor = id;
        };
        wire(typeSelect, labels[0], `treat-${n}`, `Treat ${n}`);
        wire(qty, labels[1], `treat-${n}-qty`, `Treat ${n} quantity`);
        wire(flavorSelect, labels[2], `treat-${n}-flavor`, `Treat ${n} premade flavor`);
        wire(choc, labels[3], `treat-${n}-choc`, `Treat ${n} chocolate preference`);
        wire(theme, labels[4], `treat-${n}-theme`, `Treat ${n} toppings / colors / theme`);
        // first group can't be removed; clones can, and get a divider on top
        const remove = row.querySelector<HTMLElement>('[data-remove-row]');
        remove?.classList.toggle('hidden', i === 0);
        remove?.classList.toggle('inline-flex', i !== 0);
        for (const cls of ['border-t', 'border-cocoa/15', 'pt-3', 'mt-0.5']) {
          row.classList.toggle(cls, i !== 0);
        }
      });
      addBtn.classList.toggle('hidden', rows().length >= MAX_ROWS);
    };

    addBtn.classList.remove('hidden');
    addBtn.addEventListener('click', () => {
      if (rows().length >= MAX_ROWS) return;
      const clone = rows()[0].cloneNode(true) as HTMLElement;
      clone.querySelectorAll('select').forEach((select) => { select.value = ''; });
      clone.querySelectorAll('input').forEach((input) => { input.value = ''; });
      container.appendChild(clone);
      renumber();
      clone.querySelector('select')?.focus();
    });
    container.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-remove-row]');
      if (!btn) return;
      btn.closest('[data-treat-row]')?.remove();
      renumber();
    });
    renumber();
  });

  // Progressive enhancement: submit via fetch so the visitor stays on the page
  // and sees a friendly confirmation instead of a raw JSON response.
  document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]');
    if (!btn || btn.disabled) return; // demo mode: leave inert
    // Update only the label span so the treat icon stays put through state changes.
    const label = btn.querySelector<HTMLElement>('[data-btn-label]') ?? btn;

    const sheetLog = form.dataset.sheetLog;

    // Success pop-up wiring
    const modal = form.parentElement?.querySelector<HTMLElement>('[data-success-modal]')
      ?? document.querySelector<HTMLElement>('[data-success-modal]');
    const againBtn = modal?.querySelector<HTMLButtonElement>('[data-modal-again]');
    let lastFocused: HTMLElement | null = null;
    const openModal = () => {
      if (!modal) return;
      lastFocused = document.activeElement as HTMLElement;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      againBtn?.focus();
    };
    const closeModal = () => {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      lastFocused?.focus?.();
    };
    againBtn?.addEventListener('click', () => {
      closeModal();
      form.querySelector<HTMLElement>('input[name="name"]')?.focus();
    });
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const original = label.textContent;
      btn.disabled = true;
      label.textContent = 'Sending…';
      const data = new FormData(form);
      // Drop empty optional fields so the email only lists what was filled in.
      for (const [key, value] of [...data.entries()]) {
        if (typeof value === 'string' && value.trim() === '') data.delete(key);
      }
      // Fire-and-forget log to the Google Sheet (no-cors: we don't read the
      // response). Never blocks or fails the email path below.
      if (sheetLog) {
        fetch(sheetLog, { method: 'POST', mode: 'no-cors', body: data }).catch(() => {});
      }
      try {
        const res = await fetch(form.action, { method: 'POST', body: data });
        if (res.ok) {
          form.reset();
          if (status) status.textContent = '';
          label.textContent = original;
          btn.disabled = false;
          openModal();
        } else {
          throw new Error('bad response');
        }
      } catch {
        if (status) status.textContent = 'Something went wrong — please DM @mimischocolatebites instead.';
        btn.disabled = false;
        label.textContent = original;
      }
    });
  });
</script>
