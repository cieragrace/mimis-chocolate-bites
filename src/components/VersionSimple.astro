---
/**
 * VERSION 1 — "Rich & Moody"
 * Two-tone layout: a light cream band up top holds the logo (so the cream badge
 * belongs there — no white-circle-on-dark clash), then the decadent chocolate
 * background takes over below for the tagline, buttons, offerings and form.
 * Cake pops rain over the dark portion.
 */
import InquiryForm from './InquiryForm.astro';
import Truffle from './Truffle.astro';
import CakePop from './CakePop.astro';

const IG_URL = 'https://instagram.com/mimischocolatebites';
const offerings = ['Chocolate bites', 'Cake pops', 'Gift boxes', 'Custom orders'];

// Raining cake pops — lighter/warmer palette so they read against the dark
// chocolate background. [left%, width, ball, drip, dur(s), delay(s)]
const rain = [
  { l: 4, w: 40, ball: '#e79bab', drip: '#fff5f7', dur: 9, delay: 0 },
  { l: 14, w: 30, ball: '#c9975a', drip: '#fff', dur: 12, delay: -3 },
  { l: 23, w: 48, ball: '#f6d7de', drip: '#e79bab', dur: 8, delay: -6 },
  { l: 33, w: 32, ball: '#efa0b2', drip: '#fff5f7', dur: 11, delay: -1.5 },
  { l: 42, w: 44, ball: '#f3e6d5', drip: '#c9975a', dur: 10, delay: -8 },
  { l: 51, w: 28, ball: '#e79bab', drip: '#fff', dur: 13, delay: -4 },
  { l: 60, w: 46, ball: '#c9975a', drip: '#fff5f7', dur: 8.5, delay: -2 },
  { l: 69, w: 32, ball: '#f6d7de', drip: '#e79bab', dur: 11.5, delay: -7 },
  { l: 78, w: 40, ball: '#efa0b2', drip: '#fff', dur: 9.5, delay: -5 },
  { l: 87, w: 30, ball: '#f3e6d5', drip: '#e79bab', dur: 12.5, delay: -0.5 },
  { l: 94, w: 44, ball: '#e79bab', drip: '#fff5f7', dur: 10.5, delay: -9 },
];
---

<div class="relative min-h-screen overflow-hidden bg-[#241009] text-cream">
  {/* raining cake pops (fixed to the viewport so it rains as you scroll) */}
  <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
    {rain.map((p) => (
      <div
        class="absolute top-0 animate-rain"
        style={`left:${p.l}%;width:${p.w}px;animation-duration:${p.dur}s;animation-delay:${p.delay}s`}
      >
        <CakePop ball={p.ball} drip={p.drip} class="h-auto w-full opacity-80 drop-shadow-md" />
      </div>
    ))}
  </div>

  {/* ── BROWN HEADER band ──────────────────────────────────────── */}
  <div class="relative z-10 px-6 pb-5 pt-10 text-center">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-gold/40 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.25em] text-gold"
    >
      <svg class="h-3.5 w-3.5 shrink-0 text-blush" viewBox="0 0 24 24" fill="currentColor"
        ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
      /></svg>
      Made with love
    </span>
  </div>

  {/* ── BEIGE band with the logo (centered, tight) ─────────────── */}
  <div class="relative z-10 flex items-center justify-center bg-[#e9ddc7] px-6 py-5">
    <img src="/img/logo.png" alt="Mimi's Chocolate Bites" width="360" class="w-44 sm:w-52" />
  </div>

  {/* ── BROWN band with the tagline, buttons, offerings ────────── */}
  <div class="relative z-10 mx-auto flex max-w-xl flex-col items-center px-6 pb-12 pt-8 text-center">
    <h1 class="font-serif text-3xl leading-tight text-cream sm:text-4xl">
      Handcrafted chocolate,<br />made with love.
    </h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-cream/70">
      Small-batch chocolate bites, cake pops &amp; sweet little indulgences — made just for you.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#inquire"
        class="rounded-full bg-gold px-8 py-3.5 font-bold text-cocoa shadow-lg transition hover:-translate-y-0.5 hover:brightness-105"
      >
        Place an inquiry
      </a>
      <a
        href={IG_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border-2 border-cream/25 px-6 py-3.5 font-semibold text-cream transition hover:border-blush hover:text-blush"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5.5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
        </svg>
        Follow
      </a>
    </div>

    {/* offerings, truffle-separated */}
    <div
      class="mt-9 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-gold/80"
    >
      {offerings.map((o, i) => (
        <Fragment>
          {i > 0 && <Truffle class="h-2.5 w-2.5 shrink-0 opacity-80" />}
          <span>{o}</span>
        </Fragment>
      ))}
    </div>
  </div>

  {/* inquiry — bright cream card glowing on the dark page */}
  <section id="inquire" class="relative z-10 scroll-mt-4 px-6 pb-16 pt-2">
    <div class="mx-auto max-w-xl rounded-[var(--radius-card)] bg-cream p-7 shadow-2xl ring-1 ring-gold/25 sm:p-9">
      <h2 class="mb-1 text-center font-serif text-3xl text-cocoa">Sweeten your day</h2>
      <p class="mb-7 text-center text-cocoa-soft">
        Orders, events, or just a question — send Mimi a note.
      </p>
      <InquiryForm theme="moody" />
    </div>
  </section>

  <footer class="relative z-10 border-t border-white/10 py-8 text-center text-sm text-cream/60">
    <a href={IG_URL} target="_blank" rel="noopener" class="font-semibold text-cream hover:text-blush"
      >@mimischocolatebites</a
    >
    <p class="mt-2">© {new Date().getFullYear()} Mimi's Chocolate Bites · made with love in Colorado</p>
  </footer>
</div>
