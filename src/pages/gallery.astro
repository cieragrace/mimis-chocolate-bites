---
/**
 * GALLERY page — Mimi's Instagram photos + videos, self-hosted.
 *
 * Folder-driven: drop files into src/assets/gallery/ and rebuild. Loader +
 * rules live in src/lib/gallery.ts; how-to in src/assets/gallery/README.md;
 * optional alt/caption/order overrides in src/data/gallery.json.
 *
 * !! The `_placeholder-*.png` files currently in src/assets/gallery/ are
 *    TEMPORARY (copied from public/img/treats/) — delete them when the real
 *    media lands.
 *
 * Two sections, photos first:
 *
 * 1. PHOTO GRID — every photo as a uniform 4:5 tile (2 cols phone, 3 at
 *    ≥640px, 4 at ≥1024px). The first PHOTOS_SHOWN show; a "See all N
 *    photos" button reveals the rest. Progressive enhancement: without JS
 *    every photo is visible — the extras are only collapsed once the script
 *    runs. Tapping a tile opens the lightbox; prev/next cycle photos only.
 *
 * 2. VIDEO CAROUSEL — videos only, one CSS scroll-snap strip (direction A):
 *    native swipe on phones, the centre slide large with neighbours peeking,
 *    prev/next arrows on desktop, a thin progress bar + "3 / 11". Auto-
 *    advances every 3s in a seamless clone loop; holds while hovered,
 *    keyboard-focused, viewer open, tab hidden, strip off screen, or paused
 *    via the pause button; never rotates under prefers-reduced-motion. The
 *    centre slide's video plays muted + looped while the strip is on screen
 *    (not under reduced motion); offscreen posters/videos load only when a
 *    slide is near. Tapping a side slide centres it; tapping the centre slide
 *    opens the lightbox (prev/next cycle videos only); on close the strip
 *    follows to the video the visitor ended on. Keyboard: roving tabindex —
 *    one stop for the strip, ←/→/Home/End move it, Enter opens.
 *
 * One shared lightbox: a native modal <dialog> (background inert, Esc
 * closes), Tab kept inside, ←/→ and swipe for prev/next, full uncropped
 * frame (videos with sound + controls), focus returns to the tile/slide.
 * Its item list is scoped to whichever section opened it.
 *
 * A section with no items doesn't render; the empty state shows only when
 * there are no photos AND no videos.
 */
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import Seo from '../components/Seo.astro';
import RainField from '../components/RainField.astro';
import CakePop from '../components/CakePop.astro';
import CottageStripe from '../components/CottageStripe.astro';
import { getGalleryItems } from '../lib/gallery';

const IG_URL = 'https://instagram.com/mimischocolatebites';

const focusRing =
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#241009]';

const items = getGalleryItems();
const photos = items.filter((it) => it.kind === 'image');
const videos = items.filter((it) => it.kind === 'video');

// photos visible before "See all" (the rest are collapsed once JS runs)
const PHOTOS_SHOWN = 12;
// first grid tiles load straight away (above the fold on every screen)
const PHOTOS_EAGER = 4;

// what the lightbox needs, per section (full-size WebP for photos)
const photoData = await Promise.all(
  photos.map(async (it) => {
    if (it.kind !== 'image') throw new Error('unreachable');
    const full = await getImage({ src: it.image, width: Math.min(1600, it.image.width), format: 'webp' });
    return { kind: 'image', src: full.src, alt: it.alt, caption: it.caption };
  }),
);
const videoData = await Promise.all(
  videos.map(async (it) => {
    if (it.kind !== 'video') throw new Error('unreachable');
    const poster = it.poster
      ? (await getImage({ src: it.poster, width: Math.min(1200, it.poster.width), format: 'webp' })).src
      : '';
    return { kind: 'video', src: it.url, poster, alt: it.alt, caption: it.caption };
  }),
);
// smaller posters for the strip (the lightbox gets the 1200px ones)
const slidePoster = await Promise.all(
  videos.map(async (it) =>
    it.kind === 'video' && it.poster
      ? (await getImage({ src: it.poster, width: Math.min(720, it.poster.width), format: 'webp' })).src
      : '',
  ),
);
// first few slides load straight away; the rest when the strip nears them
const EAGER = 3;

// JSON in a <script> tag — escape "<" so a caption can never close the tag
const dataJson = JSON.stringify({ photos: photoData, videos: videoData }).replace(/</g, '\\u003c');

const tileBtn = `group relative block aspect-[4/5] w-full overflow-hidden rounded-[var(--radius-card)] bg-[#3a1d12] shadow-xl ring-1 ring-gold/25 transition hover:ring-gold/60 focus-visible:ring-gold ${focusRing}`;
const subheading = 'text-center font-serif text-xl leading-tight text-cream sm:text-2xl';
const slideBtn = `group relative block aspect-[4/5] w-full overflow-hidden rounded-[var(--radius-card)] bg-[#3a1d12] shadow-2xl ring-1 ring-gold/25 transition focus-visible:ring-gold ${focusRing}`;
const arrowClass = `absolute top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-[#241009]/80 text-cream ring-1 ring-gold/40 transition hover:text-gold disabled:opacity-30 disabled:hover:text-cream focus-visible:ring-gold sm:inline-flex ${focusRing}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title="Gallery — Mimi's Chocolate Bites"
      description="Photos and videos of Mimi's handmade cake pops, chocolate covered pretzels, Oreos, strawberries and custom treat boxes — made fresh in Denver, Colorado."
      path="/gallery"
    />
  </head>
  <body class="bg-[#241009]">
    <div class="relative min-h-[100svh] bg-[#241009] text-cream">
      <RainField />

      <main class="relative z-10 mx-auto max-w-6xl px-4 pb-10 pt-6 sm:px-6">
        {/* back link, same treatment as /pricing */}
        <a
          href="/"
          class={`inline-flex min-h-11 items-center gap-1 rounded-full px-3 py-2 text-sm font-semibold text-cream/70 transition hover:text-blush focus-visible:ring-gold ${focusRing}`}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
          Back
        </a>

        {/* page header, same anatomy as /pricing */}
        <header class="mt-4 text-center">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-gold/40 px-5 py-2 text-[13px] font-semibold uppercase tracking-[0.25em] text-gold"
          >
            <svg class="h-4 w-4 shrink-0 text-blush" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            /></svg>
            Gallery
          </span>
          <h1 class="mt-4 font-serif text-3xl leading-tight text-cream sm:text-4xl">
            Fresh from Mimi's kitchen.
          </h1>
          <p class="mt-3 text-cream/70">
            Cake pops, dipped treats &amp; custom creations — a peek at recent orders.
          </p>
        </header>

        {photos.length > 0 && (
          <section class="mt-8" aria-labelledby="photos-heading" data-photos>
            <h2 id="photos-heading" class={subheading}>Recent treats</h2>
            <ul class="mt-4 grid list-none grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4" data-photo-grid>
              {photos.map((it, i) => it.kind === 'image' && (
                <li data-extra={i >= PHOTOS_SHOWN ? '' : undefined}>
                  <button type="button" class={tileBtn} data-photo={i} aria-label={`View larger: ${it.alt}`}>
                    <Image
                      src={it.image}
                      alt={it.alt}
                      widths={[240, 360, 480, 640, 800]}
                      sizes="(min-width: 1024px) 270px, (min-width: 640px) 31vw, 47vw"
                      format="webp"
                      loading={i < PHOTOS_EAGER ? 'eager' : 'lazy'}
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                    />
                  </button>
                </li>
              ))}
            </ul>
            {photos.length > PHOTOS_SHOWN && (
              <div class="mt-6 text-center">
                {/* hidden until JS collapses the extras — no-JS shows every photo */}
                <button
                  type="button"
                  hidden
                  data-see-all
                  class={`inline-flex items-center gap-2 rounded-full border-2 border-cream/25 px-6 py-3.5 font-semibold text-cream transition hover:border-blush hover:text-blush focus-visible:ring-blush ${focusRing}`}
                >
                  See all {photos.length} photos
                </button>
              </div>
            )}
          </section>
        )}

        {videos.length > 0 && (
          <section class="mt-14" aria-roledescription="carousel" aria-labelledby="videos-heading" data-carousel>
            <h2 id="videos-heading" class={subheading}>Watch it come together</h2>
            <div class="relative -mx-4 mt-3 sm:mx-0">
              <ul class="carousel-track flex list-none snap-x snap-mandatory gap-3 overflow-x-auto py-3 sm:gap-5" data-track>
                {videos.map((it, i) => (
                  <li
                    class="slide shrink-0 snap-center"
                    aria-roledescription="slide"
                    aria-label={`${i + 1} of ${videos.length}`}
                    data-slide={i}
                    data-active={i === 0 ? '' : undefined}
                  >
                    {it.kind === 'video' && (
                      <button type="button" class={slideBtn} data-open={i} tabindex={i === 0 ? 0 : -1} aria-label={`Play video with sound: ${it.alt}`}>
                        <video
                          class="h-full w-full object-cover"
                          src={slidePoster[i] ? it.url : `${it.url}#t=0.1`}
                          poster={i < EAGER ? slidePoster[i] || undefined : undefined}
                          data-poster={slidePoster[i] || undefined}
                          muted
                          playsinline
                          loop
                          preload="none"
                          aria-hidden="true"
                          tabindex="-1"
                          data-reel
                        />
                        <span
                          class="pointer-events-none absolute right-2.5 top-2.5 text-cream drop-shadow-[0_1px_3px_rgba(0,0,0,0.6)]"
                          aria-hidden="true"
                        >
                          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 001.5.86l10.5-6.5a1 1 0 000-1.72L9.5 4.64A1 1 0 008 5.5z" /></svg>
                        </span>
                      </button>
                    )}
                  </li>
                ))}
              </ul>

              {videos.length > 1 && (
                <>
                  <button type="button" class={`${arrowClass} left-2 lg:left-6`} data-prev aria-label="Previous video">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                  </button>
                  <button type="button" class={`${arrowClass} right-2 lg:right-6`} data-next aria-label="Next video">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
                  </button>
                </>
              )}
            </div>

            {/* caption + position: quiet, under the centre slide */}
            <div class="mx-auto mt-3 max-w-sm text-center">
              <p class="min-h-[2.5rem] text-sm leading-snug text-cream/75" data-caption aria-live="polite">{videos[0].caption}</p>
              {videos.length > 1 && (
                <div class="mx-auto mt-2 flex max-w-[14rem] items-center gap-3">
                  <span class="h-0.5 flex-1 overflow-hidden rounded-full bg-gold/20" aria-hidden="true">
                    <span class="progress-fill block h-full rounded-full bg-gold" data-progress style={`width:${100 / videos.length}%`} />
                  </span>
                  <span class="text-xs font-semibold tabular-nums tracking-[0.15em] text-gold/80" aria-hidden="true" data-count>1 / {videos.length}</span>
                  {/* WCAG 2.2.2: the slideshow moves on its own, so it can be paused */}
                  <button
                    type="button"
                    data-autoplay-toggle
                    aria-label="Pause slideshow"
                    class={`autoplay-toggle -my-3 -mr-3 inline-flex h-11 w-11 items-center justify-center rounded-full text-gold/70 transition hover:text-gold focus-visible:ring-gold ${focusRing}`}
                  >
                    <svg class="icon-pause h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
                    <svg class="icon-play h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 001.5.86l10.5-6.5a1 1 0 000-1.72L9.5 4.64A1 1 0 008 5.5z" /></svg>
                  </button>
                </div>
              )}
            </div>
          </section>
        )}

        {photos.length === 0 && videos.length === 0 && (
          /* empty state — the page builds before any media exists */
          <section class="mx-auto mt-8 max-w-md rounded-[var(--radius-card)] px-6 py-10 text-center shadow-2xl ring-1 ring-gold/25">
            <CakePop class="mx-auto h-14 w-auto drop-shadow-sm" />
            <h2 class="mt-4 font-serif text-2xl text-cream">Photos coming soon</h2>
            <p class="mt-2 text-cream/70">
              Mimi's filling this page with fresh treats. In the meantime, see the latest on Instagram.
            </p>
          </section>
        )}

        {/* CTA row, same buttons as /pricing */}
        <section class="mt-10 text-center">
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-gold/80">
            Made fresh. Made for you. &middot; Pick up in Denver
          </p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/contact"
              class={`inline-flex items-center gap-2 rounded-full bg-gold px-8 py-3.5 font-bold text-cocoa shadow-lg transition hover:-translate-y-0.5 hover:brightness-105 focus-visible:ring-cream ${focusRing}`}
            >
              <CakePop class="-ml-1 h-6 w-auto shrink-0 drop-shadow-sm" />
              Order your treats
            </a>
            <a
              href={IG_URL}
              target="_blank"
              rel="noopener"
              aria-label="See more on Instagram (opens in a new tab)"
              class={`inline-flex items-center gap-2 rounded-full border-2 border-cream/25 px-6 py-3.5 font-semibold text-cream transition hover:border-blush hover:text-blush focus-visible:ring-blush ${focusRing}`}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5.5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
              </svg>
              See more on Instagram
            </a>
          </div>
        </section>

      </main>

      {/* Cottage Foods disclosure — scrolling pink ribbon, full width */}
      <footer class="relative z-10 mt-2">
        <CottageStripe />
      </footer>
    </div>

    {(photos.length > 0 || videos.length > 0) && (
      <>
        <script type="application/json" id="gallery-data" set:html={dataJson} />

        {/* ── Lightbox ─────────────────────────────────────────────── */}
        <dialog
          data-lightbox
          aria-label="Gallery viewer"
          class="m-0 h-[100dvh] max-h-none w-screen max-w-none bg-transparent p-0 text-cream backdrop:bg-[#160905]/90"
        >
          <div class="relative flex h-full w-full flex-col items-center justify-center px-3 py-14 sm:px-20">
            <figure class="flex max-h-full w-full flex-col items-center" data-lb-figure>
              <div
                class="flex max-h-[calc(100dvh-9rem)] w-full items-center justify-center"
                data-lb-media
              />
              <figcaption class="mt-3 max-w-xl text-center text-sm text-cream/80" data-lb-caption />
            </figure>

            <p class="absolute left-4 top-4 text-xs font-semibold uppercase tracking-[0.2em] text-gold/80" data-lb-count aria-live="polite" />

            <button
              type="button"
              data-lb-close
              aria-label="Close"
              class={`absolute right-3 top-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#241009]/80 text-cream ring-1 ring-gold/40 transition hover:text-gold focus-visible:ring-gold ${focusRing}`}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <button
              type="button"
              data-lb-prev
              aria-label="Previous"
              class={`absolute bottom-3 left-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#241009]/80 text-cream ring-1 ring-gold/40 transition hover:text-gold focus-visible:ring-gold sm:bottom-auto sm:top-1/2 sm:-translate-y-1/2 ${focusRing}`}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            </button>
            <button
              type="button"
              data-lb-next
              aria-label="Next"
              class={`absolute bottom-3 right-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#241009]/80 text-cream ring-1 ring-gold/40 transition hover:text-gold focus-visible:ring-gold sm:bottom-auto sm:top-1/2 sm:-translate-y-1/2 ${focusRing}`}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
            </button>
          </div>
        </dialog>
      </>
    )}

    <script>
      type Item = { kind: 'image' | 'video'; src: string; alt: string; caption: string; poster?: string };
      type Scope = 'photos' | 'videos';

      const dataEl = document.getElementById('gallery-data');
      const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

      if (dataEl && dialog) {
        const data: Record<Scope, Item[]> = JSON.parse(dataEl.textContent || '{"photos":[],"videos":[]}');
        const media = dialog.querySelector<HTMLElement>('[data-lb-media]')!;
        const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
        const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
        const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
        const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
        const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-close]')!;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        // the lightbox's item list is scoped to the section that opened it
        let scope: Scope = 'photos';
        let list: Item[] = [];
        let index = 0;
        const single = () => list.length < 2;

        function stopVideo() {
          media.querySelector('video')?.pause();
        }

        function render() {
          stopVideo();
          const it = list[index];
          const cls = 'max-h-[calc(100dvh-9rem)] max-w-full rounded-[var(--radius-card)] shadow-2xl ring-1 ring-gold/25';
          let el: HTMLImageElement | HTMLVideoElement;
          if (it.kind === 'image') {
            const img = document.createElement('img');
            img.src = it.src;
            img.alt = it.alt;
            img.decoding = 'async';
            el = img;
          } else {
            const v = document.createElement('video');
            v.src = it.src;
            if (it.poster) v.poster = it.poster;
            v.controls = true;
            v.playsInline = true;
            v.loop = true;
            v.preload = 'auto';
            v.setAttribute('aria-label', it.alt);
            el = v;
            // the visitor tapped "play", so start it (with sound if allowed)
            v.play().catch(() => {
              v.muted = true;
              v.play().catch(() => {});
            });
          }
          el.className = cls;
          media.replaceChildren(el);
          caption.textContent = it.caption;
          caption.hidden = !it.caption;
          count.textContent = `${index + 1} / ${list.length}`;
        }

        function open(s: Scope, i: number) {
          scope = s;
          list = data[s];
          index = i;
          prevBtn.hidden = single();
          nextBtn.hidden = single();
          render();
          dialog!.showModal();
          closeBtn.focus();
          carousel?.sync();
          // only a video open counts as the visitor touching the carousel
          if (s === 'videos') carousel?.nudge();
        }

        function go(step: number) {
          if (single()) return;
          index = (index + step + list.length) % list.length;
          render();
        }

        // ── photo grid ────────────────────────────────────────────
        // Progressive enhancement: the server renders every tile; JS
        // collapses the ones past the first PHOTOS_SHOWN and reveals the
        // "See all" button. No JS → every photo is simply visible.
        const grid = document.querySelector<HTMLElement>('[data-photo-grid]');
        const tiles = grid ? Array.from(grid.querySelectorAll<HTMLButtonElement>('[data-photo]')) : [];
        const seeAll = document.querySelector<HTMLButtonElement>('[data-see-all]');

        function expandGrid() {
          grid?.removeAttribute('data-collapsed');
          if (seeAll) seeAll.hidden = true;
        }
        if (grid && seeAll) {
          grid.setAttribute('data-collapsed', '');
          seeAll.hidden = false;
          seeAll.addEventListener('click', () => {
            const firstExtra = grid.querySelector<HTMLButtonElement>('[data-extra] [data-photo]');
            expandGrid();
            // keep keyboard users in place: move on to the first new photo
            firstExtra?.focus({ preventScroll: true });
          });
        }
        tiles.forEach((btn, i) => btn.addEventListener('click', () => open('photos', i)));

        // ── video carousel ────────────────────────────────────────
        const carouselEl = document.querySelector<HTMLElement>('[data-carousel]');
        const carousel = carouselEl ? initCarousel(carouselEl, data.videos) : null;

        function initCarousel(section: HTMLElement, items: Item[]) {
          // Infinite loop: JS adds LOOP clones of the last items before the
          // first slide and of the first items after the last one (inert,
          // aria-hidden). Whenever scrolling settles on a clone, the strip
          // jumps instantly to the real twin — same pixels, so the jump is
          // invisible, and the loop never scrolls "back" across every slide.
          // Snap-stop keeps a hard flick to one slide, so a fling can't run
          // past the clones.
          const track = section.querySelector<HTMLElement>('[data-track]')!;
          const realSlides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
          const btns = realSlides.map((s) => s.querySelector<HTMLButtonElement>('[data-open]')!);
          const n = realSlides.length;
          const LOOP = n >= 3 ? Math.min(2, n) : 0;

          if (LOOP) {
            const mk = (s: HTMLElement) => {
              const c = s.cloneNode(true) as HTMLElement;
              c.removeAttribute('data-active');
              c.setAttribute('aria-hidden', 'true');
              c.inert = true;
              c.dataset.clone = '';
              c.querySelector('[data-open]')?.setAttribute('tabindex', '-1');
              return c;
            };
            realSlides.slice(-LOOP).forEach((s) => track.insertBefore(mk(s), realSlides[0]));
            realSlides.slice(0, LOOP).forEach((s) => track.appendChild(mk(s)));
          }
          // every slide in DOM order (clones included); pos = DOM index
          const all = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
          const reels = all.map((s) => s.querySelector<HTMLVideoElement>('video[data-reel]'));
          const realOf = (pos: number) => Number(all[pos].dataset.slide);
          const posOf = (real: number) => real + LOOP;

          const cPrev = section.querySelector<HTMLButtonElement>('[data-prev]');
          const cNext = section.querySelector<HTMLButtonElement>('[data-next]');
          const cCaption = section.querySelector<HTMLElement>('[data-caption]')!;
          const cCount = section.querySelector<HTMLElement>('[data-count]');
          const cFill = section.querySelector<HTMLElement>('[data-progress]');
          const cToggle = section.querySelector<HTMLButtonElement>('[data-autoplay-toggle]');
          let pos = posOf(0);
          let active = 0;
          let stripVisible = true;

          // wake a slide's video: poster + metadata (called when it nears view)
          function wake(p: number) {
            const v = reels[p];
            if (!v || v.dataset.awake) return;
            v.dataset.awake = '1';
            if (v.dataset.poster) v.poster = v.dataset.poster;
            v.preload = 'metadata';
          }

          function syncPlayback() {
            reels.forEach((v, p) => {
              if (!v) return;
              const play = p === pos && stripVisible && !dialog!.open && !reduceMotion.matches;
              if (play) {
                wake(p);
                v.play().catch(() => {});
              } else if (!v.paused) {
                v.pause();
              }
            });
            updateRotation();
          }

          function setPos(p: number) {
            if (p === pos && all[p].hasAttribute('data-active')) return;
            const hadFocus = section.contains(document.activeElement) && track.contains(document.activeElement);
            all[pos].removeAttribute('data-active');
            btns[active].tabIndex = -1;
            pos = p;
            active = realOf(p);
            all[p].setAttribute('data-active', '');
            btns[active].tabIndex = 0;
            if (hadFocus && !all[p].hasAttribute('data-clone')) btns[active].focus({ preventScroll: true });
            cCaption.textContent = items[active].caption;
            if (cCount) cCount.textContent = `${active + 1} / ${n}`;
            if (cFill) cFill.style.width = `${((active + 1) / n) * 100}%`;
            if (!LOOP) {
              if (cPrev) cPrev.disabled = active === 0;
              if (cNext) cNext.disabled = active === n - 1;
            }
            syncPlayback();
          }

          const leftFor = (p: number) => all[p].offsetLeft - (track.clientWidth - all[p].offsetWidth) / 2;

          function scrollToPos(p: number, smooth = !reduceMotion.matches) {
            p = Math.max(0, Math.min(all.length - 1, p));
            track.scrollTo({ left: leftFor(p), behavior: smooth ? 'smooth' : 'auto' });
            setPos(p);
          }
          const scrollToSlide = (real: number, smooth?: boolean) => scrollToPos(posOf(real), smooth);
          const step = (d: number) =>
            LOOP ? scrollToPos(pos + d) : scrollToPos(Math.max(LOOP, Math.min(posOf(n - 1), pos + d)));

          // which slide sits nearest the centre of the strip
          function nearest() {
            const mid = track.scrollLeft + track.clientWidth / 2;
            let best = 0;
            let d = Infinity;
            all.forEach((s, i) => {
              const dd = Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid);
              if (dd < d) { d = dd; best = i; }
            });
            return best;
          }

          // settled on a clone → hop to its real twin (instant, identical frame)
          function settle() {
            const p = nearest();
            if (all[p].hasAttribute('data-clone')) {
              const twin = posOf(realOf(p));
              const prev = track.style.scrollSnapType;
              track.style.scrollSnapType = 'none';
              track.scrollLeft += leftFor(twin) - leftFor(p);
              track.style.scrollSnapType = prev;
              setPos(twin);
            }
          }
          let raf = 0;
          let settleT = 0;
          track.addEventListener('scroll', () => {
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => setPos(nearest()));
            // scrollend fallback (older Safari)
            clearTimeout(settleT);
            settleT = window.setTimeout(settle, 140);
          }, { passive: true });
          track.addEventListener('scrollend', () => { clearTimeout(settleT); settle(); });

          // ── auto-rotate ── every 3s; resets on any user nudge, resumes after
          // 6s idle; held while hovered, keyboard-focused, viewer open, tab
          // hidden, strip off screen, or the visitor pressed pause.
          const TICK = 3000;
          const IDLE = 6000;
          let timer = 0;
          let hovered = false;
          let kbFocus = false;
          let userPaused = false;
          let nextDelay = TICK;

          const canRotate = () =>
            n > 1 && !reduceMotion.matches && !userPaused && !hovered && !kbFocus &&
            stripVisible && !document.hidden && !dialog!.open;

          function updateRotation() {
            const on = canRotate();
            if (on && !timer) timer = window.setTimeout(tick, nextDelay);
            if (!on && timer) { clearTimeout(timer); timer = 0; nextDelay = TICK; }
            // announce captions only when the strip isn't moving by itself
            cCaption.setAttribute('aria-live', on ? 'off' : 'polite');
            if (cToggle) cToggle.hidden = reduceMotion.matches || n < 2;
          }
          function tick() {
            timer = 0;
            nextDelay = TICK;
            if (!canRotate()) return;
            if (LOOP) step(1);
            else scrollToSlide(active === n - 1 ? 0 : active + 1);
            updateRotation();
          }
          // a visitor touched it: restart the clock with the longer idle wait
          function nudge() {
            if (timer) clearTimeout(timer);
            timer = 0;
            nextDelay = IDLE;
            updateRotation();
          }

          const strip = track.parentElement!;
          strip.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hovered = true; updateRotation(); } });
          strip.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hovered = false; nudge(); } });
          track.addEventListener('pointerdown', nudge, { passive: true });
          track.addEventListener('touchstart', nudge, { passive: true });
          track.addEventListener('wheel', nudge, { passive: true });
          section.addEventListener('focusin', (e) => {
            kbFocus = (e.target as HTMLElement).matches(':focus-visible');
            updateRotation();
          });
          section.addEventListener('focusout', (e) => {
            if (!section.contains(e.relatedTarget as Node)) { kbFocus = false; nudge(); }
          });

          cToggle?.addEventListener('click', () => {
            userPaused = !userPaused;
            cToggle.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
            cToggle.toggleAttribute('data-paused', userPaused);
            nudge();
          });

          btns.forEach((btn, i) => {
            btn.addEventListener('click', () => {
              nudge();
              if (i === active) open('videos', i);
              else scrollToSlide(i);
            });
          });
          cPrev?.addEventListener('click', () => { nudge(); step(-1); });
          cNext?.addEventListener('click', () => { nudge(); step(1); });

          track.addEventListener('keydown', (e) => {
            const k = e.key;
            let to: number | null = null;
            if (k === 'ArrowRight') to = LOOP ? -2 : Math.min(n - 1, active + 1);
            else if (k === 'ArrowLeft') to = LOOP ? -3 : Math.max(0, active - 1);
            else if (k === 'Home') to = 0;
            else if (k === 'End') to = n - 1;
            if (to === null) return;
            e.preventDefault();
            nudge();
            if (to === -2) step(1);
            else if (to === -3) step(-1);
            else scrollToSlide(to);
            btns[active].focus({ preventScroll: true });
          });

          // lazy: wake videos within ~1 strip-width of view
          const near = new IntersectionObserver((entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) wake(all.indexOf(en.target as HTMLElement));
            });
          }, { root: track, rootMargin: '0px 100% 0px 100%' });
          all.forEach((s) => near.observe(s));

          // pause playback + rotation when the strip scrolls off the page
          new IntersectionObserver(([en]) => {
            stripVisible = en.isIntersecting;
            syncPlayback();
          }, { threshold: 0.35 }).observe(track);

          reduceMotion.addEventListener('change', syncPlayback);
          document.addEventListener('visibilitychange', syncPlayback);

          // start on the first real slide, clones peeking on both sides
          track.scrollLeft = leftFor(pos);
          all[pos].removeAttribute('data-active');
          setPos(pos);
          window.addEventListener('resize', () => { track.scrollLeft = leftFor(pos); }, { passive: true });

          return {
            sync: syncPlayback,
            nudge,
            // the strip follows to wherever the visitor ended up in the viewer
            follow(i: number) {
              scrollToSlide(i, false);
              btns[i].focus({ preventScroll: true });
              syncPlayback();
            },
          };
        }

        prevBtn.addEventListener('click', () => go(-1));
        nextBtn.addEventListener('click', () => go(1));
        closeBtn.addEventListener('click', () => dialog.close());

        // click on the dark backdrop (outside the media + buttons) closes
        dialog.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          if (t === dialog || t === dialog.firstElementChild || t.hasAttribute('data-lb-media') || t.hasAttribute('data-lb-figure')) {
            dialog.close();
          }
        });

        dialog.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
          else if (e.key === 'Tab') {
            // keep Tab cycling inside the viewer
            const f = Array.from(
              dialog.querySelectorAll<HTMLElement>('button:not([hidden]), video[controls]'),
            );
            if (!f.length) return;
            const first = f[0];
            const last = f[f.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
          }
        });

        // swipe left/right on touch screens
        let sx = 0;
        let sy = 0;
        dialog.addEventListener('touchstart', (e) => {
          sx = e.touches[0].clientX;
          sy = e.touches[0].clientY;
        }, { passive: true });
        dialog.addEventListener('touchend', (e) => {
          const dx = e.changedTouches[0].clientX - sx;
          const dy = e.changedTouches[0].clientY - sy;
          if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) go(dx < 0 ? 1 : -1);
        }, { passive: true });

        // Esc (native cancel) or any close: stop playback, return focus to
        // the tile/slide the visitor ended on
        dialog.addEventListener('close', () => {
          stopVideo();
          media.replaceChildren();
          if (scope === 'videos') {
            carousel?.follow(index);
          } else {
            const tile = tiles[index];
            // ended on a photo that's still collapsed → show them all
            if (tile?.closest('[data-extra]') && grid?.hasAttribute('data-collapsed')) expandGrid();
            tile?.focus();
            carousel?.sync();
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* ── carousel strip ── */
  .carousel-track {
    --slide-w: 72vw;
    padding-inline: calc(50% - var(--slide-w) / 2);
    scroll-padding-inline: calc(50% - var(--slide-w) / 2);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 640px) {
    .carousel-track { --slide-w: 300px; }
  }
  @media (min-width: 1024px) {
    .carousel-track { --slide-w: min(360px, calc((100svh - 22rem) * 0.8)); }
  }
  .carousel-track .slide {
    width: var(--slide-w);
    scroll-snap-stop: always;
    transition: transform 0.35s ease, opacity 0.35s ease;
    transform: scale(0.88);
    opacity: 0.5;
  }
  .carousel-track .slide[data-active] {
    transform: none;
    opacity: 1;
  }
  .autoplay-toggle .icon-play,
  .autoplay-toggle[data-paused] .icon-pause {
    display: none;
  }
  .autoplay-toggle[data-paused] .icon-play {
    display: block;
  }
  .progress-fill {
    transition: width 0.35s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-track .slide,
    .progress-fill,
    [data-photo-grid] img {
      transition: none;
    }
  }

  /* ── photo grid ── extras collapse only once JS has run (see script) */
  [data-photo-grid][data-collapsed] > [data-extra] {
    display: none;
  }

  /* no page scroll behind the open lightbox */
  html:has(dialog[data-lightbox][open]) {
    overflow: hidden;
  }
</style>
