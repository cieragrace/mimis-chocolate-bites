---
/**
 * GALLERY page — Mimi's Instagram photos + videos, self-hosted.
 *
 * Folder-driven: drop files into src/assets/gallery/ and rebuild. Loader +
 * rules live in src/lib/gallery.ts; how-to in src/assets/gallery/README.md;
 * optional alt/caption/order overrides in src/data/gallery.json.
 *
 * !! The `_placeholder-*.png` files currently in src/assets/gallery/ are
 *    TEMPORARY (copied from public/img/treats/) — delete them when the real
 *    media lands.
 *
 * Carousel (direction A): one CSS scroll-snap strip — native swipe on
 * phones, the centre slide large with neighbours peeking, prev/next arrows
 * on desktop, a thin progress bar + "3 / 11". Photos and videos share one
 * strip in one 4:5 frame (they are all treats; mixing keeps the newest work
 * together). The centre slide's video plays muted + looped while the strip
 * is on screen (never under prefers-reduced-motion); the rest sit paused on
 * their poster, and offscreen videos/posters are only loaded when a slide
 * is near. Tapping a side slide brings it to the centre; tapping the centre
 * slide opens the lightbox: a native modal <dialog> (background inert, Esc
 * closes), Tab kept inside, ←/→ and swipe for prev/next, full uncropped
 * frame with sound + controls. On close the strip follows to the item the
 * visitor ended on. Keyboard: roving tabindex — one stop for the strip,
 * ←/→/Home/End move it, Enter opens.
 */
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import Seo from '../components/Seo.astro';
import RainField from '../components/RainField.astro';
import CakePop from '../components/CakePop.astro';
import CottageNotice from '../components/CottageNotice.astro';
import { getGalleryItems } from '../lib/gallery';

const IG_URL = 'https://instagram.com/mimischocolatebites';

const focusRing =
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#241009]';

const items = getGalleryItems();

// what the lightbox needs, per item (full-size WebP for photos)
const lightboxData = await Promise.all(
  items.map(async (it) => {
    if (it.kind === 'image') {
      const full = await getImage({ src: it.image, width: Math.min(1600, it.image.width), format: 'webp' });
      return { kind: 'image', src: full.src, alt: it.alt, caption: it.caption };
    }
    const poster = it.poster
      ? (await getImage({ src: it.poster, width: Math.min(1200, it.poster.width), format: 'webp' })).src
      : '';
    return { kind: 'video', src: it.url, poster, alt: it.alt, caption: it.caption };
  }),
);
// smaller posters for the strip (the lightbox gets the 1200px ones)
const slidePoster = await Promise.all(
  items.map(async (it) =>
    it.kind === 'video' && it.poster
      ? (await getImage({ src: it.poster, width: Math.min(720, it.poster.width), format: 'webp' })).src
      : '',
  ),
);
// first few slides load straight away; the rest when the strip nears them
const EAGER = 3;

// JSON in a <script> tag — escape "<" so a caption can never close the tag
const dataJson = JSON.stringify(lightboxData).replace(/</g, '\\u003c');

const slideBtn = `group relative block aspect-[4/5] w-full overflow-hidden rounded-[var(--radius-card)] bg-[#3a1d12] shadow-2xl ring-1 ring-gold/25 transition focus-visible:ring-gold ${focusRing}`;
const arrowClass = `absolute top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-[#241009]/80 text-cream ring-1 ring-gold/40 transition hover:text-gold disabled:opacity-30 disabled:hover:text-cream focus-visible:ring-gold sm:inline-flex ${focusRing}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title="Gallery — Mimi's Chocolate Bites"
      description="Photos and videos of Mimi's handmade cake pops, chocolate covered pretzels, Oreos, strawberries and custom treat boxes — made fresh in Denver, Colorado."
      path="/gallery"
    />
  </head>
  <body class="bg-[#241009]">
    <div class="relative min-h-[100svh] bg-[#241009] text-cream">
      <RainField />

      <main class="relative z-10 mx-auto max-w-6xl px-4 pb-10 pt-6 sm:px-6">
        {/* back link, same treatment as /pricing */}
        <a
          href="/"
          class={`inline-flex min-h-11 items-center gap-1 rounded-full px-3 py-2 text-sm font-semibold text-cream/70 transition hover:text-blush focus-visible:ring-gold ${focusRing}`}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
          Back
        </a>

        {/* page header, same anatomy as /pricing */}
        <header class="mt-4 text-center">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-gold/40 px-5 py-2 text-[13px] font-semibold uppercase tracking-[0.25em] text-gold"
          >
            <svg class="h-4 w-4 shrink-0 text-blush" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            /></svg>
            Gallery
          </span>
          <h1 class="mt-4 font-serif text-3xl leading-tight text-cream sm:text-4xl">
            Fresh from Mimi's kitchen.
          </h1>
          <p class="mt-3 text-cream/70">
            Cake pops, dipped treats &amp; custom creations — a peek at recent orders.
          </p>
        </header>

        {items.length > 0 ? (
          <section class="mt-8" aria-roledescription="carousel" aria-label="Recent treats" data-carousel>
            <div class="relative -mx-4 sm:mx-0">
              <ul class="carousel-track flex list-none snap-x snap-mandatory gap-3 overflow-x-auto py-3 sm:gap-5" data-track>
                {items.map((it, i) => (
                  <li
                    class="slide shrink-0 snap-center"
                    aria-roledescription="slide"
                    aria-label={`${i + 1} of ${items.length}`}
                    data-slide={i}
                    data-active={i === 0 ? '' : undefined}
                  >
                    {it.kind === 'image' ? (
                      <button type="button" class={slideBtn} data-open={i} tabindex={i === 0 ? 0 : -1} aria-label={`View larger: ${it.alt}`}>
                        <Image
                          src={it.image}
                          alt={it.alt}
                          widths={[360, 540, 720]}
                          sizes="(min-width: 1024px) 360px, (min-width: 640px) 300px, 72vw"
                          format="webp"
                          loading={i < EAGER ? 'eager' : 'lazy'}
                          class="h-full w-full object-cover"
                        />
                      </button>
                    ) : (
                      <button type="button" class={slideBtn} data-open={i} tabindex={i === 0 ? 0 : -1} aria-label={`Play video with sound: ${it.alt}`}>
                        <video
                          class="h-full w-full object-cover"
                          src={slidePoster[i] ? it.url : `${it.url}#t=0.1`}
                          poster={i < EAGER ? slidePoster[i] || undefined : undefined}
                          data-poster={slidePoster[i] || undefined}
                          muted
                          playsinline
                          loop
                          preload="none"
                          aria-hidden="true"
                          tabindex="-1"
                          data-reel
                        />
                        <span
                          class="pointer-events-none absolute right-2.5 top-2.5 text-cream drop-shadow-[0_1px_3px_rgba(0,0,0,0.6)]"
                          aria-hidden="true"
                        >
                          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 001.5.86l10.5-6.5a1 1 0 000-1.72L9.5 4.64A1 1 0 008 5.5z" /></svg>
                        </span>
                      </button>
                    )}
                  </li>
                ))}
              </ul>

              {items.length > 1 && (
                <>
                  <button type="button" class={`${arrowClass} left-2 lg:left-6`} data-prev aria-label="Previous treat" disabled>
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                  </button>
                  <button type="button" class={`${arrowClass} right-2 lg:right-6`} data-next aria-label="Next treat">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
                  </button>
                </>
              )}
            </div>

            {/* caption + position: quiet, under the centre slide */}
            <div class="mx-auto mt-3 max-w-sm text-center">
              <p class="min-h-[2.5rem] text-sm leading-snug text-cream/75" data-caption aria-live="polite">{items[0].caption}</p>
              {items.length > 1 && (
                <div class="mx-auto mt-3 flex max-w-[12rem] items-center gap-3" aria-hidden="true">
                  <span class="h-0.5 flex-1 overflow-hidden rounded-full bg-gold/20">
                    <span class="progress-fill block h-full rounded-full bg-gold" data-progress style={`width:${100 / items.length}%`} />
                  </span>
                  <span class="text-xs font-semibold tabular-nums tracking-[0.15em] text-gold/80" data-count>1 / {items.length}</span>
                </div>
              )}
            </div>
          </section>
        ) : (
          /* empty state — the page builds before any media exists */
          <section class="mx-auto mt-8 max-w-md rounded-[var(--radius-card)] px-6 py-10 text-center shadow-2xl ring-1 ring-gold/25">
            <CakePop class="mx-auto h-14 w-auto drop-shadow-sm" />
            <h2 class="mt-4 font-serif text-2xl text-cream">Photos coming soon</h2>
            <p class="mt-2 text-cream/70">
              Mimi's filling this page with fresh treats. In the meantime, see the latest on Instagram.
            </p>
          </section>
        )}

        {/* CTA row, same buttons as /pricing */}
        <section class="mt-10 text-center">
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-gold/80">
            Made fresh. Made for you. &middot; Pick up in Denver
          </p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/contact"
              class={`inline-flex items-center gap-2 rounded-full bg-gold px-8 py-3.5 font-bold text-cocoa shadow-lg transition hover:-translate-y-0.5 hover:brightness-105 focus-visible:ring-cream ${focusRing}`}
            >
              <CakePop class="-ml-1 h-6 w-auto shrink-0 drop-shadow-sm" />
              Order your treats
            </a>
            <a
              href={IG_URL}
              target="_blank"
              rel="noopener"
              aria-label="See more on Instagram (opens in a new tab)"
              class={`inline-flex items-center gap-2 rounded-full border-2 border-cream/25 px-6 py-3.5 font-semibold text-cream transition hover:border-blush hover:text-blush focus-visible:ring-blush ${focusRing}`}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5.5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
              </svg>
              See more on Instagram
            </a>
          </div>
        </section>

        <footer class="mt-12">
          <CottageNotice class="mx-auto max-w-2xl text-center text-[11px] leading-relaxed" />
        </footer>
      </main>
    </div>

    {items.length > 0 && (
      <>
        <script type="application/json" id="gallery-data" set:html={dataJson} />

        {/* ── Lightbox ─────────────────────────────────────────────── */}
        <dialog
          data-lightbox
          aria-label="Gallery viewer"
          class="m-0 h-[100dvh] max-h-none w-screen max-w-none bg-transparent p-0 text-cream backdrop:bg-[#160905]/90"
        >
          <div class="relative flex h-full w-full flex-col items-center justify-center px-3 py-14 sm:px-20">
            <figure class="flex max-h-full w-full flex-col items-center" data-lb-figure>
              <div
                class="flex max-h-[calc(100dvh-9rem)] w-full items-center justify-center"
                data-lb-media
              />
              <figcaption class="mt-3 max-w-xl text-center text-sm text-cream/80" data-lb-caption />
            </figure>

            <p class="absolute left-4 top-4 text-xs font-semibold uppercase tracking-[0.2em] text-gold/80" data-lb-count aria-live="polite" />

            <button
              type="button"
              data-lb-close
              aria-label="Close"
              class={`absolute right-3 top-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#241009]/80 text-cream ring-1 ring-gold/40 transition hover:text-gold focus-visible:ring-gold ${focusRing}`}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <button
              type="button"
              data-lb-prev
              aria-label="Previous"
              class={`absolute bottom-3 left-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#241009]/80 text-cream ring-1 ring-gold/40 transition hover:text-gold focus-visible:ring-gold sm:bottom-auto sm:top-1/2 sm:-translate-y-1/2 ${focusRing}`}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            </button>
            <button
              type="button"
              data-lb-next
              aria-label="Next"
              class={`absolute bottom-3 right-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#241009]/80 text-cream ring-1 ring-gold/40 transition hover:text-gold focus-visible:ring-gold sm:bottom-auto sm:top-1/2 sm:-translate-y-1/2 ${focusRing}`}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
            </button>
          </div>
        </dialog>
      </>
    )}

    <script>
      type Item = { kind: 'image' | 'video'; src: string; alt: string; caption: string; poster?: string };

      const dataEl = document.getElementById('gallery-data');
      const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

      if (dataEl && dialog) {
        const items: Item[] = JSON.parse(dataEl.textContent || '[]');
        const media = dialog.querySelector<HTMLElement>('[data-lb-media]')!;
        const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
        const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
        const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
        const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
        const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-close]')!;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        let index = 0;

        const single = items.length < 2;
        prevBtn.hidden = single;
        nextBtn.hidden = single;

        function stopVideo() {
          media.querySelector('video')?.pause();
        }

        function render() {
          stopVideo();
          const it = items[index];
          const cls = 'max-h-[calc(100dvh-9rem)] max-w-full rounded-[var(--radius-card)] shadow-2xl ring-1 ring-gold/25';
          let el: HTMLImageElement | HTMLVideoElement;
          if (it.kind === 'image') {
            const img = document.createElement('img');
            img.src = it.src;
            img.alt = it.alt;
            img.decoding = 'async';
            el = img;
          } else {
            const v = document.createElement('video');
            v.src = it.src;
            if (it.poster) v.poster = it.poster;
            v.controls = true;
            v.playsInline = true;
            v.loop = true;
            v.preload = 'auto';
            v.setAttribute('aria-label', it.alt);
            el = v;
            // the visitor tapped "play", so start it (with sound if allowed)
            v.play().catch(() => {
              v.muted = true;
              v.play().catch(() => {});
            });
          }
          el.className = cls;
          media.replaceChildren(el);
          caption.textContent = it.caption;
          caption.hidden = !it.caption;
          count.textContent = `${index + 1} / ${items.length}`;
        }

        function open(i: number, _from: HTMLElement) {
          index = i;
          render();
          dialog!.showModal();
          closeBtn.focus();
          syncPlayback();
        }

        function go(step: number) {
          if (single) return;
          index = (index + step + items.length) % items.length;
          render();
        }

        // ── carousel ──────────────────────────────────────────────
        const track = document.querySelector<HTMLElement>('[data-track]')!;
        const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
        const btns = slides.map((s) => s.querySelector<HTMLButtonElement>('[data-open]')!);
        const reels = slides.map((s) => s.querySelector<HTMLVideoElement>('video[data-reel]'));
        const cPrev = document.querySelector<HTMLButtonElement>('[data-prev]');
        const cNext = document.querySelector<HTMLButtonElement>('[data-next]');
        const cCaption = document.querySelector<HTMLElement>('[data-caption]')!;
        const cCount = document.querySelector<HTMLElement>('[data-count]');
        const cFill = document.querySelector<HTMLElement>('[data-progress]');
        let active = 0;
        let stripVisible = true;

        // wake a slide's video: poster + metadata (called when it nears view)
        function wake(i: number) {
          const v = reels[i];
          if (!v || v.dataset.awake) return;
          v.dataset.awake = '1';
          if (v.dataset.poster) v.poster = v.dataset.poster;
          v.preload = 'metadata';
        }

        function syncPlayback() {
          reels.forEach((v, i) => {
            if (!v) return;
            const play = i === active && stripVisible && !dialog!.open && !reduceMotion.matches;
            if (play) {
              wake(i);
              v.play().catch(() => {});
            } else if (!v.paused) {
              v.pause();
            }
          });
        }

        function setActive(i: number) {
          if (i === active && slides[i].hasAttribute('data-active')) return;
          const hadFocus = slides.some((s) => s.contains(document.activeElement));
          slides[active].removeAttribute('data-active');
          btns[active].tabIndex = -1;
          active = i;
          slides[i].setAttribute('data-active', '');
          btns[i].tabIndex = 0;
          if (hadFocus) btns[i].focus({ preventScroll: true });
          cCaption.textContent = items[i].caption;
          if (cCount) cCount.textContent = `${i + 1} / ${items.length}`;
          if (cFill) cFill.style.width = `${((i + 1) / items.length) * 100}%`;
          if (cPrev) cPrev.disabled = i === 0;
          if (cNext) cNext.disabled = i === items.length - 1;
          syncPlayback();
        }

        function scrollToSlide(i: number, smooth = !reduceMotion.matches) {
          i = Math.max(0, Math.min(items.length - 1, i));
          const s = slides[i];
          track.scrollTo({
            left: s.offsetLeft - (track.clientWidth - s.offsetWidth) / 2,
            behavior: smooth ? 'smooth' : 'auto',
          });
          setActive(i);
        }

        // which slide sits nearest the centre of the strip
        function nearest() {
          const mid = track.scrollLeft + track.clientWidth / 2;
          let best = 0;
          let d = Infinity;
          slides.forEach((s, i) => {
            const dd = Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid);
            if (dd < d) { d = dd; best = i; }
          });
          return best;
        }
        let raf = 0;
        track.addEventListener('scroll', () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => setActive(nearest()));
        }, { passive: true });

        btns.forEach((btn, i) => {
          btn.addEventListener('click', () => {
            if (i === active) open(i, btn);
            else scrollToSlide(i);
          });
        });
        cPrev?.addEventListener('click', () => scrollToSlide(active - 1));
        cNext?.addEventListener('click', () => scrollToSlide(active + 1));

        track.addEventListener('keydown', (e) => {
          const k = e.key;
          const to =
            k === 'ArrowRight' ? active + 1 :
            k === 'ArrowLeft' ? active - 1 :
            k === 'Home' ? 0 :
            k === 'End' ? items.length - 1 : null;
          if (to === null) return;
          e.preventDefault();
          scrollToSlide(to);
          btns[active].focus({ preventScroll: true });
        });

        // lazy: wake videos within ~1 strip-width of view
        const near = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) wake(Number((en.target as HTMLElement).dataset.slide));
          });
        }, { root: track, rootMargin: '0px 100% 0px 100%' });
        slides.forEach((s) => near.observe(s));

        // pause when the strip scrolls off the page
        new IntersectionObserver(([en]) => {
          stripVisible = en.isIntersecting;
          syncPlayback();
        }, { threshold: 0.35 }).observe(track);

        reduceMotion.addEventListener('change', syncPlayback);
        document.addEventListener('visibilitychange', () => {
          stripVisible = !document.hidden;
          syncPlayback();
        });
        setActive(0);

        prevBtn.addEventListener('click', () => go(-1));
        nextBtn.addEventListener('click', () => go(1));
        closeBtn.addEventListener('click', () => dialog.close());

        // click on the dark backdrop (outside the media + buttons) closes
        dialog.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          if (t === dialog || t === dialog.firstElementChild || t.hasAttribute('data-lb-media') || t.hasAttribute('data-lb-figure')) {
            dialog.close();
          }
        });

        dialog.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
          else if (e.key === 'Tab') {
            // keep Tab cycling inside the viewer
            const f = Array.from(
              dialog.querySelectorAll<HTMLElement>('button:not([hidden]), video[controls]'),
            );
            if (!f.length) return;
            const first = f[0];
            const last = f[f.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
          }
        });

        // swipe left/right on touch screens
        let sx = 0;
        let sy = 0;
        dialog.addEventListener('touchstart', (e) => {
          sx = e.touches[0].clientX;
          sy = e.touches[0].clientY;
        }, { passive: true });
        dialog.addEventListener('touchend', (e) => {
          const dx = e.changedTouches[0].clientX - sx;
          const dy = e.changedTouches[0].clientY - sy;
          if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) go(dx < 0 ? 1 : -1);
        }, { passive: true });

        // Esc (native cancel) or any close: stop playback, return focus
        dialog.addEventListener('close', () => {
          stopVideo();
          media.replaceChildren();
          // the strip follows to wherever the visitor ended up in the viewer
          scrollToSlide(index, false);
          btns[index].focus({ preventScroll: true });
          syncPlayback();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* ── carousel strip ── */
  .carousel-track {
    --slide-w: 72vw;
    padding-inline: calc(50% - var(--slide-w) / 2);
    scroll-padding-inline: calc(50% - var(--slide-w) / 2);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 640px) {
    .carousel-track { --slide-w: 300px; }
