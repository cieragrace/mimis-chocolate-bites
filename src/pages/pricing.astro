---
/**
 * PRICING page — TWO sections, one per pricing doc Mimi sent:
 *   1. "Treat Packages"  (her flyer — REAL prices, built)
 *   2. "By the Dozen"    (her second doc — NOT RECEIVED YET, see below)
 *
 * ── DESIGN NOTE ───────────────────────────────────────────────────────────
 * MIMI DESIGNED THE FLYER. This page is a re-layout of it, not a redesign:
 * the chocolate drip, the script wordmark, the berry ribbon name banners,
 * heart bullets, the decor strip and the specialty ribbon are all hers and
 * should survive any future mobile/layout work. What changed is only the
 * *arrangement* — the three packages stack on phones instead of sitting in a
 * fixed 3-up grid, and the footer wraps.
 *
 * The flyer lives on a cream background, so both sections sit on cream panels
 * inside the site's moody frame rather than recoloring her work.
 *
 * PACKAGE PRICES ARE REAL — Mini $30 / Standard $85 / Deluxe $150. The
 * Standard tier genuinely lists "12 of your choice" twice (two separate dozen
 * selections, 36 total); that's her copy, not a duplication bug.
 *
 * BY-THE-DOZEN PRICES ARE REAL TOO, off her second flyer. Note that flyer sells
 * a different list than the packages one — no cake pops; it's Oreo, Rice
 * Krispies, Cakesicles and Pretzel Rods/Knots, each at a half-dozen and a dozen
 * price, with a caramel add-on on the pretzels only.
 *
 * Her two flyers are deliberately different colorways (packages = cream,
 * by-the-dozen = pink with dark chocolate cards), so the two panels keep their
 * own palettes instead of being homogenized.
 */
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import RainField from '../components/RainField.astro';
import CakePop from '../components/CakePop.astro';

const IG_URL = 'https://instagram.com/mimischocolatebites';

// Sampled straight off Mimi's flyers so the page matches her artwork exactly:
// ribbon/heart berry, the pink flyer's panel, its dark cards and title pink.
const BERRY = '#c8465e';
const DOZEN_CARD = '#3b2613';
const DOZEN_TITLE = '#ef8692';

const packages = [
  {
    tier: 'Mini',
    price: '$30',
    size: 'One dozen treats',
    note: '(mix & match)',
    items: ['4 Cake Pops', '4 Chocolate Covered Pretzels', '4 Chocolate Covered Oreos'],
  },
  {
    tier: 'Standard',
    price: '$85',
    size: 'Three dozen treats',
    note: null,
    items: [
      '12 of your choice Oreos, pretzel rods/twists or Krispies',
      '12 of your choice Oreos, pretzel rods/twists or Krispies',
      '12 Cake Pops',
    ],
  },
  {
    tier: 'Deluxe',
    price: '$150',
    size: 'Five dozen treats',
    note: null,
    items: ['20 Cake Pops', '20 Chocolate Covered Pretzels', '20 Chocolate Covered Oreos'],
  },
];

// SECTION 2 — Mimi's "By the Dozen" flyer. REAL prices, in her order.
// That flyer is pink with dark-chocolate cards (the packages one is cream), so
// this section keeps its own palette rather than being flattened to match.
const PINK_PANEL = '#f7ded6';

const byTheDozen = [
  { item: 'Oreo', half: '$15', dozen: '$25', addOn: null, icon: 'oreo' },
  { item: 'Rice Krispies', half: '$22', dozen: '$32', addOn: null, icon: 'krispie' },
  { item: 'Cakesicles', half: '$24', dozen: '$36', addOn: null, icon: 'cakesicle' },
  {
    item: 'Pretzel Rods/Knots',
    half: '$15',
    dozen: '$25',
    addOn: '$2+ add caramel',
    icon: 'pretzel',
  },
];

// Chocolate drips along the top of the cream panel — stem + bulb per drip,
// matching the flyer's uneven, hand-poured look.
const drips = [
  { x: 60, r: 14, len: 30 },
  { x: 160, r: 9, len: 16 },
  { x: 250, r: 16, len: 44 },
  { x: 360, r: 10, len: 22 },
  { x: 470, r: 13, len: 34 },
  { x: 580, r: 8, len: 14 },
  { x: 690, r: 15, len: 40 },
  { x: 800, r: 11, len: 24 },
  { x: 910, r: 14, len: 32 },
  { x: 1010, r: 9, len: 18 },
  { x: 1120, r: 16, len: 42 },
];

const focusRing =
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#241009]';
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title="Pricing — Mimi's Chocolate Bites"
      description="Treat packages and per-dozen pricing — cake pops, chocolate covered pretzels, Oreos & Krispies. Mini $30, Standard $85, Deluxe $150. Made fresh, pick up in Denver."
      path="/pricing"
    />
  </head>
  <body class="bg-[#241009]">
    <div class="relative min-h-[100svh] bg-[#241009] text-cream">
      <RainField />

      <main class="relative z-10 mx-auto max-w-4xl px-4 pb-16 pt-6 sm:px-6">
        {/* back link, same treatment as /contact and /reviews */}
        <a
          href="/"
          class={`inline-flex min-h-11 items-center gap-1 rounded-full px-3 py-2 text-sm font-semibold text-cream/70 transition hover:text-blush focus-visible:ring-gold ${focusRing}`}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
          Back
        </a>

        {/* jump between the two pricing sections */}
        <nav class="mt-4 flex flex-wrap justify-center gap-2 text-sm" aria-label="Pricing sections">
          <a
            href="#packages"
            class={`rounded-full border border-gold/40 px-5 py-2 font-semibold text-gold transition hover:border-gold hover:text-cream focus-visible:ring-gold ${focusRing}`}
          >
            Treat packages
          </a>
          <a
            href="#by-the-dozen"
            class={`rounded-full border border-gold/40 px-5 py-2 font-semibold text-gold transition hover:border-gold hover:text-cream focus-visible:ring-gold ${focusRing}`}
          >
            By the dozen
          </a>
        </nav>

        {/* ── SECTION 1 — Mimi's flyer, re-laid-out ──────────────────── */}
        <div
          id="packages"
          class="relative mt-6 scroll-mt-6 overflow-hidden rounded-[var(--radius-card)] bg-cream text-cocoa shadow-2xl ring-1 ring-gold/25"
        >
          {/* chocolate drip */}
          <svg
            class="block h-14 w-full sm:h-[4.5rem]"
            viewBox="0 0 1200 78"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <rect x="0" y="0" width="1200" height="32" fill="#3a2216" />
            {drips.map((d) => (
              <g fill="#3a2216">
                <rect x={d.x - d.r * 0.92} y="26" width={d.r * 1.84} height={d.len} rx={d.r * 0.92} />
                <circle cx={d.x} cy={28 + d.len} r={d.r} />
              </g>
            ))}
          </svg>

          <div class="px-5 pb-8 pt-2 sm:px-8 sm:pb-10">
            {/* masthead */}
            <header class="text-center">
              <img
                src="/img/logo.png"
                alt="Mimi's Chocolate Bites"
                class="mx-auto h-24 w-auto sm:h-28"
              />
              <h1 class="mt-1 font-script text-5xl leading-none text-cocoa sm:text-6xl lg:text-7xl">
                Treat Packages
              </h1>
              <div class="mt-5 flex items-center justify-center gap-3">
                <span class="h-px w-12 sm:w-16" style={`background:${BERRY};opacity:.55`}></span>
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill={BERRY} aria-hidden="true"
                  ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                /></svg>
                <span class="h-px w-12 sm:w-16" style={`background:${BERRY};opacity:.55`}></span>
              </div>
              <p
                class="mt-4 text-[13px] font-bold uppercase tracking-[0.18em] text-choc sm:text-base sm:tracking-[0.22em]"
              >
                Sweet treats. Made with love.
              </p>
            </header>

            {/* three packages — 3-up on desktop, stacked on phones */}
            <ul class="mt-12 grid list-none gap-12 sm:gap-6 lg:grid-cols-3">
              {packages.map((p) => (
                <li
                  class="relative flex flex-col rounded-2xl border px-5 pb-7 pt-10"
                  style={`border-color:${BERRY}33`}
                >
                  {/* ribbon name banner, notched at both ends like the flyer */}
                  <h2
                    class="absolute left-1/2 top-0 w-[max-content] max-w-[92%] -translate-x-1/2 -translate-y-1/2 px-7 py-1.5 text-center text-lg font-bold uppercase tracking-[0.16em] text-cream sm:text-xl"
                    style={`background:${BERRY};clip-path:polygon(0 0,100% 0,calc(100% - 12px) 50%,100% 100%,0 100%,12px 50%)`}
                  >
                    {p.tier}
                  </h2>

                  <p class="text-center font-serif text-5xl leading-none text-cocoa">{p.price}</p>
                  <p class="mt-3 text-center text-[13px] font-bold uppercase tracking-[0.12em] text-choc">
                    {p.size}
                    {p.note && <span class="mt-0.5 block font-semibold tracking-[0.08em]">{p.note}</span>}
                  </p>

                  <div class="my-5 flex items-center justify-center gap-3">
                    <span class="h-px w-8" style={`background:${BERRY};opacity:.4`}></span>
                    <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill={BERRY} aria-hidden="true"
                      ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                    /></svg>
                    <span class="h-px w-8" style={`background:${BERRY};opacity:.4`}></span>
                  </div>

                  <ul class="mx-auto flex max-w-xs list-none flex-col gap-3">
                    {p.items.map((item) => (
                      <li class="flex items-start gap-2.5 text-[15px] leading-snug text-cocoa sm:text-base">
                        <svg class="mt-1 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill={BERRY} aria-hidden="true"
                          ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                        /></svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>

                  {/* her treat photo, lifted off the flyer card it came from */}
                  <img
                    src={`/img/treats/pkg-${p.tier.toLowerCase()}.png`}
                    alt=""
                    aria-hidden="true"
                    class="mx-auto mt-auto w-52 max-w-full pt-6"
                  />
                </li>
              ))}
            </ul>

            {/* basic decor strip */}
            <section class="mt-10 rounded-2xl border px-5 py-6" style={`border-color:${BERRY}33`}>
              <h2
                class="text-center text-base font-bold uppercase tracking-[0.14em] sm:text-lg"
                style={`color:${BERRY}`}
              >
                Basic decor includes:
              </h2>
              <ul
                class="mt-5 flex list-none flex-col items-center gap-5 sm:flex-row sm:justify-center sm:gap-0"
              >
                <li class="flex items-center gap-3 sm:flex-1 sm:justify-center">
                  {/* dipped — a chocolate pour */}
                  <svg class="h-10 w-10 shrink-0" viewBox="0 0 40 40" aria-hidden="true">
                    <rect x="8" y="9" width="24" height="13" rx="6.5" fill="#3a2216" />
                    <rect x="11" y="18" width="5" height="8" rx="2.5" fill="#3a2216" />
                    <circle cx="13.5" cy="26" r="3.5" fill="#3a2216" />
                    <rect x="17.5" y="18" width="5.5" height="12" rx="2.75" fill="#3a2216" />
                    <circle cx="20.25" cy="30" r="4" fill="#3a2216" />
                    <rect x="25" y="18" width="4.5" height="6" rx="2.25" fill="#3a2216" />
                    <circle cx="27.25" cy="24" r="3" fill="#3a2216" />
                  </svg>
                  <span class="text-sm font-bold uppercase tracking-[0.14em] text-cocoa">Dipped</span>
                </li>
                <li class="hidden h-10 w-px shrink-0 sm:block" style={`background:${BERRY};opacity:.3`}></li>
                <li class="flex items-center gap-3 sm:flex-1 sm:justify-center">
                  {/* drizzled — a squiggle */}
                  <svg class="h-10 w-10 shrink-0" viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="20" cy="20" r="15" fill="none" stroke="#3a2216" stroke-width="1.2" opacity=".35" />
                    <path
                      d="M11 25c4-2 4-6 8-6s4 4 8 2M11 20c4-2 4-6 8-6s4 4 8 2"
                      fill="none"
                      stroke="#3a2216"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span class="text-sm font-bold uppercase tracking-[0.14em] text-cocoa">Drizzled</span>
                </li>
                <li class="hidden h-10 w-px shrink-0 sm:block" style={`background:${BERRY};opacity:.3`}></li>
                <li class="flex items-center gap-3 sm:flex-1 sm:justify-center">
                  {/* sprinkles — dotted circle */}
                  <svg class="h-10 w-10 shrink-0" viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="20" cy="20" r="15" fill="none" stroke="#3a2216" stroke-width="1.2" opacity=".35" />
                    {[
                      [20, 11], [26, 13], [29, 19], [26, 26], [20, 28], [13, 26], [11, 19], [14, 13],
                      [20, 17], [24, 20], [20, 23], [16, 20],
                    ].map(([cx, cy]) => (
                      <circle cx={cx} cy={cy} r="1.5" fill={BERRY} />
                    ))}
                  </svg>
                  <span class="text-center text-sm font-bold uppercase leading-tight tracking-[0.14em] text-cocoa">
                    Sprinkles<span class="sm:block"> if desired</span>
                  </span>
                </li>
              </ul>
            </section>

            {/* specialty ribbon */}
            <p
              class="mx-auto mt-8 max-w-2xl rounded-full px-6 py-3 text-center text-sm font-bold uppercase tracking-[0.12em] text-cream sm:text-base"
              style={`background:${BERRY}`}
            >
              <svg class="mr-2 inline-block h-4 w-4 align-[-2px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              /></svg>
              Specialty flavors &amp; custom themes available!
            </p>

            {/* footer strip — wraps to as many rows as it needs on a phone */}
            <ul
              class="mt-8 flex list-none flex-wrap items-center justify-center gap-x-5 gap-y-3 text-center text-xs font-bold uppercase tracking-[0.1em] text-choc sm:text-[13px]"
            >
              <li>
                <a
                  href={IG_URL}
                  target="_blank"
                  rel="noopener"
                  aria-label="Mimi's Chocolate Bites on Instagram (opens in a new tab)"
                  class="inline-flex items-center gap-2 transition hover:text-[#c43e63] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
                >
                  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5.5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
                  </svg>
                  @mimischocolatebites
                </a>
              </li>
              <li class="flex items-center gap-2">
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill={BERRY} aria-hidden="true"
                  ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                /></svg>
                Made fresh. Made for you.
              </li>
              <li class="flex items-center gap-2">
                <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                Pick up in Denver
              </li>
            </ul>
          </div>
        </div>

        {/* ── SECTION 2 — Mimi's pink "By the Dozen" flyer ───────────── */}
        <div
          id="by-the-dozen"
          class="relative mt-8 scroll-mt-6 overflow-hidden rounded-[var(--radius-card)] text-cocoa shadow-2xl ring-1 ring-gold/25"
          style={`background:${PINK_PANEL}`}
        >
          {/* her drip again — this flyer has one too */}
          <svg
            class="block h-14 w-full sm:h-[4.5rem]"
            viewBox="0 0 1200 78"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <rect x="0" y="0" width="1200" height="32" fill="#3a2216" />
            {drips.map((d) => (
              <g fill="#3a2216">
                <rect x={d.x - d.r * 0.92} y="26" width={d.r * 1.84} height={d.len} rx={d.r * 0.92} />
                <circle cx={d.x} cy={28 + d.len} r={d.r} />
              </g>
            ))}
          </svg>

          <div class="px-5 pb-8 pt-2 sm:px-8 sm:pb-10">
            <header class="text-center">
              <img
                src="/img/logo.png"
                alt="Mimi's Chocolate Bites"
                class="mx-auto h-24 w-auto sm:h-28"
              />
              <p
                class="mt-3 flex items-center justify-center gap-2 text-[13px] font-bold uppercase tracking-[0.18em] text-cocoa sm:text-base sm:tracking-[0.2em]"
              >
                Sweet treats. Made with love.
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill={BERRY} aria-hidden="true"
                  ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                /></svg>
              </p>
              {/* her bold caps wordmark with the berry underline */}
              <h2 class="mt-6 inline-block text-3xl font-extrabold uppercase tracking-[0.06em] text-cocoa sm:text-4xl">
                By the Dozen
                <span class="mt-1.5 block h-[3px] w-full rounded-full" style={`background:${BERRY}`}></span>
              </h2>
            </header>

            {/* dark chocolate treat cards, 2-up on desktop and stacked on phones */}
            <ul class="mt-9 grid list-none gap-5 sm:grid-cols-2">
              {byTheDozen.map((row) => (
                <li
                  class="flex items-center gap-4 rounded-2xl px-5 py-5 text-cream shadow-lg"
                  style={`background:${DOZEN_CARD}`}
                >
                  <div class="min-w-0 flex-1">
                    <h3
                      class="text-xl font-extrabold uppercase italic leading-tight tracking-[0.02em] sm:text-2xl"
                      style={`color:${DOZEN_TITLE}`}
                    >
                      {row.item}
                    </h3>
                    <dl class="mt-3 flex flex-col gap-1.5 text-[15px] text-cream/90">
                      <div class="flex items-baseline gap-2">
                        <dt class="font-semibold">half dozen &mdash;</dt>
                        <dd class="font-bold text-cream">{row.half}</dd>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <dt class="font-semibold">dozen &mdash;</dt>
                        <dd class="font-bold text-cream">{row.dozen}</dd>
                      </div>
                      {row.addOn && (
                        <div class="mt-0.5 text-sm font-semibold" style={`color:${DOZEN_TITLE}`}>
                          {row.addOn}
                        </div>
                      )}
                    </dl>
                  </div>

                  {/* Mimi's own product photos, lifted off her flyer */}
                  <img
                    src={`/img/treats/${row.icon}.png`}
                    alt=""
                    aria-hidden="true"
                    class="h-20 w-auto shrink-0 sm:h-24"
                  />
                </li>
              ))}
            </ul>

            {/* her footer: Denver ribbon over the site url */}
            <div class="mt-9 text-center">
              <p
                class="inline-flex items-center gap-3 rounded-full px-7 py-2 text-sm font-bold uppercase tracking-[0.12em] text-cocoa sm:text-base"
                style={`background:${BERRY}33`}
              >
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill={BERRY} aria-hidden="true"
                  ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                /></svg>
                Denver, CO
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill={BERRY} aria-hidden="true"
                  ><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                /></svg>
              </p>
              <p class="mt-4 text-sm font-bold tracking-[0.04em] text-choc sm:text-base">
                www.mimischocolatebites.com
              </p>
            </div>
          </div>
        </div>

        {/* CTA — off the flyer, into the inquiry form */}
        <section class="mt-10 text-center">
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              href="/contact"
              class={`inline-flex items-center gap-2 rounded-full bg-gold px-8 py-3.5 font-bold text-cocoa shadow-lg transition hover:-translate-y-0.5 hover:brightness-105 focus-visible:ring-cream ${focusRing}`}
            >
              <CakePop class="-ml-1 h-6 w-auto shrink-0 drop-shadow-sm" />
              Order your treats
            </a>
            <a
              href={IG_URL}
              target="_blank"
              rel="noopener"
              aria-label="DM Mimi's Chocolate Bites on Instagram (opens in a new tab)"
              class={`inline-flex items-center gap-2 rounded-full border-2 border-cream/25 px-6 py-3.5 font-semibold text-cream transition hover:border-blush hover:text-blush focus-visible:ring-blush ${focusRing}`}
            >
