---
/**
 * Mimi's Chocolate Bites — single-page site (Rich & Moody).
 *
 * The other design directions (Fun & Playful, Cool & Crafted) and the
 * version-picker showroom live on the `showroom-all-versions` branch if we
 * ever want to revisit them.
 */
import '../styles/global.css';
import VersionSimple from '../components/VersionSimple.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <title>Mimi's Chocolate Bites</title>
    <meta
      name="description"
      content="Handmade chocolate bites, cake pops and sweet treats — made with love, made to order."
    />
  </head>
  <body class="bg-[#241009]">
    <VersionSimple />
  </body>
</html>
